{
  "name": "the-lowlands",
  "version": "1.4.3",
  "description": "Real-time strategy browser game with a LAN multiplayer server",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node test/mp-test.js",
    "test:rules": "node test/rules-test.js",
    "test:soak": "node test/sim-test.js",
    "test:audio": "node test/audio-test.js",
    "test:ui": "node test/ui-test.js",
    "build:host": "node host/build.js",
    "test:host": "node test/host-app-test.js",
    "test:updater": "node test/updater-test.js",
    "test:netsoak": "node test/net-soak-test.js",
    "test:move": "node test/move-test.js",
    "test:netsoak:pop": "SOAK_POP=1 node test/net-soak-test.js"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "license": "MIT",
  "bin": "host/launcher.js",
  "pkg": {
    "scripts": [
      "server.js"
    ],
    "assets": [
      "index.html"
    ],
    "outputPath": "dist/bin"
  }
}
